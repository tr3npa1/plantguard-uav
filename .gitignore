# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Local Python environments
.venv/
venv/
env/

# Packaging output
build/
dist/
*.egg-info/

# Test, coverage, lint, and type-check output
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
configs/local*.yaml
*.pem
*.key

# Runtime state and generated artifacts
/artifacts/*
!/artifacts/.gitkeep
/logs/
/models/*
!/models/.gitkeep
/results/*
!/results/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Large or generated datasets
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Editors and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
